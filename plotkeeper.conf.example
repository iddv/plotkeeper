# Copy to plotkeeper.conf and edit. Environment variables override these values.
PLOTKEEPER_HOST=127.0.0.1
PLOTKEEPER_PORT=8080
PLOTKEEPER_DATA_DIR=./data
# Leave empty to generate one into the data directory at first run.
PLOTKEEPER_SESSION_SECRET=
PLOTKEEPER_LOG_LEVEL=INFO
# Leave empty to use the garden time zone chosen at setup.
PLOTKEEPER_TIMEZONE=
